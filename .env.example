# ---- PostgreSQL ----
POSTGRES_DB=sistemaan
POSTGRES_USER=sistemaan
POSTGRES_PASSWORD=sistemaan
POSTGRES_PORT=5432

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ---- JWT ----
# IMPORTANTE: use uma chave forte (>= 32 caracteres) em produção.
JWT_SECRET_KEY=change-me-please-use-a-strong-secret-key-32chars
JWT_ISSUER=SistemaAN
JWT_AUDIENCE=SistemaAN.Client

# ---- Frontend ----
WEB_PORT=4200
